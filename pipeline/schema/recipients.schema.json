{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/RecipientsFile",
  "definitions": {
    "RecipientsFile": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "FeatureCollection"
        },
        "features": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Feature%3CPoly%2CRecipient%3E"
          }
        }
      },
      "required": [
        "type",
        "features"
      ],
      "additionalProperties": false
    },
    "Feature<Poly,Recipient>": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "Feature"
        },
        "id": {
          "type": "string"
        },
        "geometry": {
          "$ref": "#/definitions/Poly"
        },
        "properties": {
          "$ref": "#/definitions/Recipient"
        }
      },
      "required": [
        "type",
        "id",
        "geometry",
        "properties"
      ],
      "additionalProperties": false
    },
    "Poly": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "Polygon"
            },
            "coordinates": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  }
                }
              }
            }
          },
          "required": [
            "type",
            "coordinates"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "MultiPolygon"
            },
            "coordinates": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    }
                  }
                }
              }
            }
          },
          "required": [
            "type",
            "coordinates"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Recipient": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "address": {
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "$ref": "#/definitions/Archetype"
        },
        "position": {
          "$ref": "#/definitions/Position"
        },
        "floorAreaM2": {
          "type": "number"
        },
        "floorAreaMethod": {
          "type": "string",
          "enum": [
            "levels",
            "height",
            "assumed_3_levels",
            "reported"
          ]
        },
        "heightM": {
          "type": [
            "number",
            "null"
          ]
        },
        "yearBuilt": {
          "type": [
            "number",
            "null"
          ]
        },
        "ownerType": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "public",
            "institutional",
            "private",
            null
          ]
        },
        "heatingSystem": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "hydronic",
            "forced_air",
            null
          ]
        },
        "boilerYearsLeft": {
          "type": [
            "number",
            "null"
          ]
        },
        "activePermit": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "estimate": {
          "$ref": "#/definitions/Estimate"
        },
        "distances": {
          "$ref": "#/definitions/Distances"
        },
        "fit": {
          "$ref": "#/definitions/FitAssessment"
        },
        "rank": {
          "type": [
            "number",
            "null"
          ]
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "lastVerified": {
          "type": [
            "string",
            "null"
          ]
        },
        "synthetic": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "name",
        "address",
        "type",
        "position",
        "floorAreaM2",
        "floorAreaMethod",
        "heightM",
        "yearBuilt",
        "ownerType",
        "heatingSystem",
        "boilerYearsLeft",
        "activePermit",
        "estimate",
        "distances",
        "fit",
        "rank",
        "sourceIds",
        "lastVerified",
        "synthetic"
      ],
      "additionalProperties": false
    },
    "Archetype": {
      "type": "string",
      "enum": [
        "office",
        "multi_res",
        "retail",
        "school",
        "hotel",
        "civic",
        "hospital",
        "mixed"
      ]
    },
    "Position": {
      "type": "array",
      "minItems": 2,
      "items": [
        {
          "type": "number",
          "title": "longitude"
        },
        {
          "type": "number",
          "title": "latitude"
        }
      ],
      "maxItems": 2,
      "description": "ThermoStat data contract. Extends design/handoff/code/data-contract.ts; handoff names are unchanged. Timestamps and dates are ISO 8601. Unknown values are null, never 0 or ''."
    },
    "Estimate": {
      "type": "object",
      "properties": {
        "annualHeatMwh": {
          "type": "number"
        },
        "peakHeatKw": {
          "type": "number"
        },
        "networkKw": {
          "type": "number"
        },
        "quality": {
          "$ref": "#/definitions/DataQuality"
        },
        "method": {
          "type": "string",
          "enum": [
            "bps_actual",
            "archetype_calibrated",
            "archetype_start"
          ]
        },
        "intensityKwhM2": {
          "type": [
            "number",
            "null"
          ]
        },
        "ageFactor": {
          "type": [
            "number",
            "null"
          ]
        },
        "calibration": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "n": {
                  "type": "number"
                },
                "medianKwhM2": {
                  "type": "number"
                },
                "year": {
                  "type": "number"
                }
              },
              "required": [
                "n",
                "medianKwhM2",
                "year"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "actual": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "gasM3": {
                  "type": "number"
                },
                "year": {
                  "type": "number"
                },
                "bpsOperationId": {
                  "type": "string"
                }
              },
              "required": [
                "gasM3",
                "year",
                "bpsOperationId"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "annualHeatMwh",
        "peakHeatKw",
        "networkKw",
        "quality",
        "method",
        "intensityKwhM2",
        "ageFactor",
        "calibration",
        "actual",
        "sourceIds"
      ],
      "additionalProperties": false
    },
    "DataQuality": {
      "type": "string",
      "enum": [
        "actual",
        "checked",
        "estimate"
      ]
    },
    "Distances": {
      "type": "object",
      "properties": {
        "existingM": {
          "type": [
            "number",
            "null"
          ]
        },
        "plannedM": {
          "type": [
            "number",
            "null"
          ]
        },
        "plannedQuality": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "approx_route",
            "illustrative_route",
            null
          ]
        },
        "minM": {
          "type": [
            "number",
            "null"
          ]
        },
        "quality": {
          "type": "string",
          "enum": [
            "known_customer",
            "approx_route",
            "illustrative_route"
          ]
        }
      },
      "required": [
        "existingM",
        "plannedM",
        "plannedQuality",
        "minM",
        "quality"
      ],
      "additionalProperties": false
    },
    "FitAssessment": {
      "type": "object",
      "properties": {
        "band": {
          "$ref": "#/definitions/FitBand"
        },
        "score": {
          "type": "number"
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "missing": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "points": {
          "type": "object",
          "properties": {
            "size": {
              "type": "number"
            },
            "distance": {
              "type": "number"
            },
            "heating": {
              "type": "number"
            },
            "anchor": {
              "type": "number"
            },
            "timing": {
              "type": "number"
            },
            "data": {
              "type": "number"
            }
          },
          "required": [
            "size",
            "distance",
            "heating",
            "anchor",
            "timing",
            "data"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "band",
        "score",
        "reasons",
        "missing",
        "points"
      ],
      "additionalProperties": false
    },
    "FitBand": {
      "type": "string",
      "enum": [
        "strong",
        "possible",
        "weak"
      ]
    }
  }
}
