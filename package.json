{
  "name": "thermostat",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "schema": "node scripts/schema.mjs",
    "contrast": "node scripts/contrast.mjs",
    "check:print": "node scripts/print-check.mjs",
    "shots": "node scripts/shots.mjs",
    "check:offline": "node scripts/offline-check.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run contrast",
    "shots:notes": "node scripts/notes-shots.mjs",
    "shots:states": "node scripts/states-shots.mjs"
  },
  "dependencies": {
    "@deck.gl/core": "9.4.0",
    "@deck.gl/extensions": "9.4.0",
    "@deck.gl/layers": "9.4.0",
    "@deck.gl/mapbox": "9.4.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/literata": "5.3.0",
    "@protomaps/basemaps": "5.7.2",
    "maplibre-gl": "5.24.0",
    "pmtiles": "4.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "ajv": "8.20.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "puppeteer-core": "25.14.0",
    "ts-json-schema-generator": "2.9.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
